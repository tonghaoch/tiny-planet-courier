{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**/*.ts", "**/*.js", "**/*.mjs", "**/*.json", "!package-lock.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "arrowParentheses": "asNeeded" } },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": { "noUnreachable": "error", "noUnsafeFinally": "error", "useValidTypeof": "error" },
      "suspicious": { "noDuplicateCase": "error", "noDuplicateParameters": "error", "noDuplicateObjectKeys": "error" }
    }
  }
}
