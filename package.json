{
  "name": "tiny-planet-courier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:bundle": "node --test scripts/check-bundle.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:browser": "playwright test",
    "test:preview": "npm run build && playwright test --config=playwright.preview.config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.check.json",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm test && npm run test:bundle && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.3",
    "@types/three": "^0.185.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
